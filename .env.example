# From https://myapi.fyers.in/dashboard/ . Never commit the filled-in .env.
# FYERS_REDIRECT_URI must match the redirect URL registered on the app exactly.
# The CLI's `npm run login` listens on it; the web API serves /auth/fyers/callback
# (locally http://127.0.0.1:4000/auth/fyers/callback). One Fyers app has one
# redirect URI, so point it at whichever you use; M5 adds a second app for the web.

FYERS_APP_ID=XXXXXXXXX-100
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://127.0.0.1:5000/callback

# Daily cap on Fyers data calls for this process's store (default 4800). Once
# deployed: 1000 locally, 3800 on the server — one Fyers account, one budget.
# REST_DAILY_CAP=4800

# Which watchlist the live runner watches.
LIVE_LIST=core.txt

# Set to 1 to print every websocket frame. Noisy with 39 symbols — leave unset
# unless you are debugging the feed.
# DEBUG_TICKS=1

# Web app only (api/). The CLI never reads it. Local dev: Homebrew Postgres,
# see README § Local database. On Render: Neon's pooled connection string.
# DATABASE_URL=postgres://localhost/backtest
# Encrypts the Fyers token in Postgres (web app only). 32 random bytes, base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENC_KEY=
# Web API (npm run api). PORT defaults to 4000; FRONTEND_URL is the only origin
# CORS allows, defaulting to Vite's http://localhost:5173 (required in production).
# PORT=4000
# FRONTEND_URL=http://localhost:5173
# App login (web API). APP_PASSWORD_HASH from `npm run -s hash-password`;
# SESSION_SECRET is ≥32 random chars (`openssl rand -hex 32`). Changing the
# secret logs every browser out.
# APP_PASSWORD_HASH=
# SESSION_SECRET=
