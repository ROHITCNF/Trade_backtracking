# Copy to .env and fill in. Never commit the filled-in .env.
# The CLI (npm start, runAll, login, live) reads the Fyers block; the web API
# (npm run api) reads everything. On Render these are service env vars instead
# (render.yaml, docs/deploy.md).

# --- Fyers app (https://myapi.fyers.in/dashboard/) --------------------------
# FYERS_REDIRECT_URI must match the app's registered redirect URL exactly. The
# CLI's `npm run login` listens on it; the web API serves /auth/fyers/callback
# (locally http://127.0.0.1:4000/auth/fyers/callback). One app has one redirect
# URI, so locally point it at whichever you use; production uses a second app.
FYERS_APP_ID=XXXXXXXXX-100
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://127.0.0.1:5000/callback

# Daily cap on Fyers data calls for this process's store (default 4800). Both
# sides spend one account's 5,000/day: 1000 locally, 3800 on the server.
# REST_DAILY_CAP=4800

# --- CLI live runner --------------------------------------------------------
LIVE_LIST=core.txt
# DEBUG_TICKS=1                 # print every websocket frame (noisy)

# --- Web live paper trading (api/live.js) -----------------------------------
# LIVE_ENABLED=true              # start the paper session inside the API on market days
# LIVE_WATCHLIST=core            # watchlist name in Postgres

# --- Web API (api/) — the CLI never reads these -----------------------------
# Postgres. Local: Homebrew (README § Local database). Production: Neon's
# pooled connection string, which carries sslmode=require.
# DATABASE_URL=postgres://localhost/backtest

# App login. APP_PASSWORD_HASH from `npm run -s hash-password`; SESSION_SECRET
# is ≥32 random chars (`openssl rand -hex 32`) — changing it logs everyone out.
# APP_PASSWORD_HASH=
# SESSION_SECRET=

# Encrypts the Fyers token at rest: 32 random bytes, base64
# (`openssl rand -base64 32`). Changing it orphans the stored token (reconnect).
# TOKEN_ENC_KEY=

# PORT defaults to 4000. FRONTEND_URL is the only origin CORS allows and where
# the OAuth callback sends the browser; defaults to Vite's http://localhost:5173,
# required when NODE_ENV=production.
# PORT=4000
# FRONTEND_URL=http://localhost:5173
# NODE_ENV=production
